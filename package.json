{
  "name": "dsh-lingxi-panel",
  "version": "1.1.0",
  "displayName": "灵犀",
  "description": "灵犀工作台：闸门、环境事实、技能提名、进化疗效与记忆库合成一个原生面板，明暗主题跟随应用。",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./memory": "./memory/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./semantic": "./semantic.js"
  },
  "files": [
    "index.js",
    "semantic.js",
    "client.js",
    "injector.js",
    "metrics.js",
    "evolve.js",
    "lessons.js",
    "scenes.js",
    "procedures.js",
    "instructions.js",
    "hygiene.js",
    "memoryTool.js",
    "noise.js",
    "audit.mjs",
    "memory/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "scripts": {
    "test": "node test-all.mjs",
    "audit": "node audit.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "cordis",
    "memory",
    "agent-memory",
    "lingxi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaobaga281/dsh-lingxi-panel.git"
  },
  "homepage": "https://github.com/xiaobaga281/dsh-lingxi-panel#readme",
  "bugs": {
    "url": "https://github.com/xiaobaga281/dsh-lingxi-panel/issues"
  },
  "author": "xiaobaga281",
  "engines": {
    "node": ">=20"
  }
}
